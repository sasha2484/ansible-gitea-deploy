version: "3.4"

services:
  db:
    image: postgres:16-alpine
    restart: always
    environment:
      - POSTGRES_USER=gitea
      - POSTGRES_PASSWORD={{ gitea_db_password }}
      - POSTGRES_DB=gitea
    volumes:
      - {{ gitea_data_dir }}/postgres:/var/lib/postgresql/data
    networks:
      - gitea
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U gitea"]
      interval: 10s
      timeout: 5s
      retries: 5

  gitea:
    image: gitea/gitea:latest
    restart: always
    depends_on:
      db:
        condition: service_healthy
    environment:
      - USER_UID={{ 1000 }}
      - USER_GID={{ 1000 }}
      - GITEA__database__DB_TYPE=postgres
      - GITEA__database__HOST=db:5432
      - GITEA__database__NAME=gitea
      - GITEA__database__USER=gitea
      - GITEA__database__PASSWD={{ gitea_db_password }}
      - GITEA__server__DOMAIN={{ gitea_domain }}
      - GITEA__server__SSH_DOMAIN={{ gitea_domain }}
      - GITEA__server__HTTP_PORT={{ gitea_http_port }}
      - GITEA__server__SSH_PORT={{ gitea_ssh_port }}
      - GITEA__server__ROOT_URL=http://{{ gitea_domain }}:{{ gitea_http_port }}
      - GITEA__server__DISABLE_SSH=false
      - GITEA__server__START_SSH_SERVER=true
      - GITEA__server__SSH_LISTEN_PORT={{ gitea_ssh_port }}
      - GITEA__server__OFFLINE_MODE=false
      - GITEA__server__LFS_START_SERVER=true
      - GITEA__server__LFS_CONTENT_PATH=/data/git/lfs
      - GITEA__server__LFS_JWT_SECRET={{ gitea_lfs_secret | default('random_string') }}
    volumes:
      - {{ gitea_data_dir }}/gitea:/data
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
    ports:
      - "{{ gitea_http_port }}:{{ gitea_http_port }}"
      - "{{ gitea_ssh_port }}:{{ gitea_ssh_port }}"
    networks:
      - gitea

networks:
  gitea:
    driver: bridge