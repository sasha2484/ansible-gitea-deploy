services:
  db:
    image: postgres:16-alpine
    restart: always
    container_name: gitea-db
    environment:
      - POSTGRES_USER=gitea
      - POSTGRES_PASSWORD={{ gitea_db_password }}
      - POSTGRES_DB=gitea
    volumes:
      - {{ gitea_data_dir }}/postgres:/var/lib/postgresql/data
    networks:
      - gitea-net
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U gitea"]
      interval: 10s
      timeout: 5s
      retries: 5

  gitea:
    image: gitea/gitea:latest
    restart: always
    container_name: gitea
    depends_on:
      db:
        condition: service_healthy
    environment:
      - USER_UID=1000
      - USER_GID=1000
      - GITEA__database__DB_TYPE=postgres
      - GITEA__database__HOST=db:5432
      - GITEA__database__NAME=gitea
      - GITEA__database__USER=gitea
      - GITEA__database__PASSWD={{ gitea_db_password }}
      - GITEA__server__DOMAIN={{ gitea_domain }}
      - GITEA__server__SSH_DOMAIN={{ gitea_domain }}
      - GITEA__server__HTTP_PORT=3000
      - GITEA__server__SSH_PORT=2222
      - GITEA__server__ROOT_URL=https://{{ gitea_domain }}
      - GITEA__server__PROTOCOL=http
      - GITEA__server__HTTP_ADDR=0.0.0.0
      - GITEA__server__DISABLE_SSH=false
      - GITEA__server__START_SSH_SERVER=true
      - GITEA__server__SSH_LISTEN_PORT=2222
    volumes:
      - {{ gitea_data_dir }}/gitea:/data
      - /etc/timezone:/etc/timezone:ro
      - /etc/localtime:/etc/localtime:ro
    networks:
      - gitea-net
    ports:
      - "127.0.0.1:3000:3000"
      - "{{ gitea_ssh_port }}:2222"

  nginx:
    image: nginx:alpine
    restart: always
    container_name: nginx
    depends_on:
      - gitea
    volumes:
      - {{ gitea_compose_dir }}/nginx.conf:/etc/nginx/conf.d/default.conf:ro
      - {{ gitea_data_dir }}/certbot/www:/var/www/certbot:ro
      - {{ gitea_data_dir }}/certbot/conf:/etc/letsencrypt:ro
    networks:
      - gitea-net
    ports:
      - "80:80"
      - "443:443"

  certbot:
    image: certbot/certbot:latest
    restart: unless-stopped
    container_name: certbot
    depends_on:
      - nginx
    volumes:
      - {{ gitea_data_dir }}/certbot/conf:/etc/letsencrypt
      - {{ gitea_data_dir }}/certbot/www:/var/www/certbot
    entrypoint: "/bin/sh -c 'trap exit TERM; while :; do certbot renew; sleep 12h & wait $${!}; done;'"

networks:
  gitea-net:
    driver: bridge
